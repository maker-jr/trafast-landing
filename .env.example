# Server-side only — read by netlify/functions/waitlist.ts.
# Set these in Netlify under Site configuration > Environment variables.
# Never prefix them with VITE_, or Vite will inline them into the public bundle.

RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Cookieless analytics (Umami). Public by design — the website id identifies the
# site, not a person, and is visible in the page source either way. Leave both
# blank to disable analytics entirely, which is what local builds should do.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
